{
  "name": "mermaid-studio",
  "private": true,
  "version": "2.4.3",
  "description": "Free, open-source Mermaid diagram editor with in-browser AI (WebGPU), drag-and-drop visual editor, folders and version history. No account.",
  "homepage": "https://www.mermaidstudio.net/",
  "author": "Jérémie Dufault",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CatFoxVoyager/MermaidStudio.git"
  },
  "packageManager": "pnpm@10.34.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "node scripts/generate-sitemap.mjs && npm run type-check && vite build",
    "build:analyze": "vite build",
    "check:elk": "node scripts/check-elk-chunk.mjs",
    "check:ai-lazy": "node scripts/check-ai-lazy.mjs",
    "check:editor-lazy": "node scripts/check-editor-lazy.mjs",
    "check:cdn-embed": "vitest run src/constants/__tests__/cdnEmbed.test.ts",
    "check:version-tag": "node scripts/check-version-tag.mjs",
    "check:readme-app-section": "node scripts/check-readme-app-section.mjs",
    "check:readme-app-section:selftest": "node scripts/check-readme-app-section.mjs --self-test",
    "preview": "vite preview",
    "benchmark": "node scripts/build/benchmark.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:lighthouse": "lhci autorun --collect.url=http://localhost:5173",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "format:check": "prettier --check src/**/*.{ts,tsx}",
    "prepare": "husky",
    "docs": "node scripts/docs/generate-docs.cjs",
    "docs:check": "node scripts/docs/check-doc-quality.cjs",
    "docs:test": "node scripts/docs/test-docs.cjs",
    "e2e:install": "npx playwright install",
    "e2e:report": "node scripts/e2e/generate-e2e-report.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@huggingface/transformers": "^4.3.2",
    "@mlc-ai/web-llm": "file:vendor/mlc-ai-web-llm-0.2.83.tgz",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "html2canvas": "^1.4.1",
    "i18next": "^26.7.1",
    "khroma": "^2.1.0",
    "lucide-react": "^1.66.0",
    "mermaid": "12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "chrome-launcher": "^1.2.2",
    "fake-indexeddb": "^6.2.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^24.22.2",
    "npm": ">=10.9.9"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "tmp": "^0.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "undici": "8.11.2"
    }
  }
}
