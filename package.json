{
  "name": "mermaid-studio",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "build:analyze": "vite build",
    "check:elk": "node scripts/check-elk-chunk.mjs",
    "check:ai-lazy": "node scripts/check-ai-lazy.mjs",
    "check:cdn-embed": "vitest run src/constants/__tests__/cdnEmbed.test.ts",
    "preview": "vite preview",
    "benchmark": "node scripts/build/benchmark.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:lighthouse": "lhci autorun --collect.url=http://localhost:5173",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "format:check": "prettier --check src/**/*.{ts,tsx}",
    "prepare": "husky",
    "docs": "node scripts/docs/generate-docs.cjs",
    "docs:check": "node scripts/docs/check-doc-quality.cjs",
    "docs:test": "node scripts/docs/test-docs.cjs",
    "e2e:install": "npx playwright install",
    "e2e:report": "node scripts/e2e/generate-e2e-report.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@huggingface/transformers": "^4.3.0",
    "@mlc-ai/web-llm": "file:vendor\\mlc-ai-web-llm-0.2.83.tgz",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.2",
    "khroma": "^2.1.0",
    "lucide-react": "^1.51.0",
    "mermaid": "12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "chrome-launcher": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^24.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "tmp": "^0.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
}
